# ── 必填 ────────────────────────────────────────────────
# Render 部署時自動提供（web service 的 10000 port / 資料庫連線）
PORT=10000
DATABASE_URL=postgres://user:pass@host:5432/world_sim

# Anthropic（改用官方 API，不再是 Replit 代理）
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=https://api.anthropic.com
AI_INTEGRATIONS_ANTHROPIC_API_KEY=sk-ant-xxxx

# Discord（同一個應用程式：bot token + OAuth2 憑證）
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# 管理員後台密碼（自訂一串隨機字）
ADMIN_TOKEN=

# ── 選填 ────────────────────────────────────────────────
# 回合/新聞排程時區
NEWS_SCHEDULE_TZ=Asia/Taipei
# AI 模型分層（預設都是 Haiku；quality 線要更好的結果設回 Sonnet）
# AI_MODEL_QUALITY=claude-haiku-4-5
# AI_MODEL_BULK=claude-haiku-4-5
LOG_LEVEL=info
# Docker 部署時前端靜態檔位置（Dockerfile 已設定）
STATIC_DIR=/app/public
