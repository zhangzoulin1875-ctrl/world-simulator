# ── 必填 ────────────────────────────────────────────────
# Render 部署時自動提供（web service 的 10000 port / 資料庫連線）
PORT=10000
DATABASE_URL=postgres://user:pass@host:5432/world_sim

# AI 供應商（OpenAI 相容端點；變數名沿用歷史名稱）
# NVIDIA NIM：https://build.nvidia.com 取得 nvapi- 開頭的 key
# 也可換 OpenRouter / Groq / DeepSeek 等任何 OpenAI 相容服務
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=https://integrate.api.nvidia.com/v1
AI_INTEGRATIONS_ANTHROPIC_API_KEY=nvapi-xxxx

# Discord（同一個應用程式：bot token + OAuth2 憑證）
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# 管理員後台密碼（自訂一串隨機字）
ADMIN_TOKEN=

# ── 選填 ────────────────────────────────────────────────
# 回合/新聞排程時區
NEWS_SCHEDULE_TZ=Asia/Taipei
# AI 模型分層（預設 NVIDIA NIM 的 Llama 3.3 70B；可換任何該平台的模型 ID）
# AI_MODEL_QUALITY=meta/llama-3.3-70b-instruct
# AI_MODEL_BULK=meta/llama-3.3-70b-instruct
LOG_LEVEL=info
# Docker 部署時前端靜態檔位置（Dockerfile 已設定）
STATIC_DIR=/app/public
